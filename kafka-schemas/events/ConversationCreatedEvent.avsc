{
  "type": "record",
  "name": "ConversationCreatedEvent",
  "namespace": "cm.fastrelays.events",
  "fields": [
    { "name": "id", "type": "string", "logicalType": "uuid" },
    { "name": "topic", "type": "string" },
    { "name": "title", "type": "string" },
    { "name": "orderRequestId", "type": ["null", "string"], "default": null, "logicalType": "uuid" },
    { "name": "participants", "type": { "type": "array", "items": "string" } },
    { "name": "userId", "type": ["null", "string"], "default": null, "logicalType": "uuid" },
    { "name": "createdAt", "type": "string", "format": "date-time" },
    { "name": "eventId", "type": "string", "logicalType": "uuid" }
  ]
}
